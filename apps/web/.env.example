# Apple Music (MusicKit) — developer.apple.com > Certificates, IDs & Profiles > Keys (enable MusicKit)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Contents of the .p8 file. Newlines may be written as \n on one line.
APPLE_MUSIC_PRIVATE_KEY=

# YouTube Data API v3 key — console.cloud.google.com, restrict it to the YouTube Data API
YOUTUBE_API_KEY=

# Default catalog storefront (ISO country code)
DEFAULT_STOREFRONT=us
