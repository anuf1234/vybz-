# Apple Music (MusicKit) — developer.apple.com > Certificates, IDs & Profiles > Keys (enable MusicKit)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Contents of the .p8 file. Newlines may be written as \n on one line.
APPLE_MUSIC_PRIVATE_KEY=

# YouTube Data API v3 key — console.cloud.google.com, restrict it to the YouTube Data API
YOUTUBE_API_KEY=

# Default catalog storefront (ISO country code)
DEFAULT_STOREFRONT=us

# Database (see packages/db/.env.example)
DATABASE_URL=postgresql://postgres:vybz@localhost:5432/vybz

# Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional) — console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web)
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (optional in development: links are printed to the terminal instead)
RESEND_API_KEY=
EMAIL_FROM="VYBZ <no-reply@mail.urexp.com>"

# Set to 1 only when developing offline: skips the Have I Been Pwned password check. Ignored in production.
SKIP_BREACHED_PASSWORD_CHECK=

# Development only: a sample catalog with generated tones so battles work without Apple Music keys.
MUSIC_FIXTURES=

# Shared secret for the battle deadline sweep (GET /api/cron/advance-battles). Vercel Cron sends it automatically.
CRON_SECRET=

# Logging: debug | info | warn | error (default info in production, debug in development)
LOG_LEVEL=

# ─── Uploads (DJ mixes, avatars) ─────────────────────────────────────────────
# Production: a private Cloudflare R2 bucket. dash.cloudflare.com > R2 > Manage API tokens (Object Read & Write, this bucket only).
# The bucket's CORS policy must allow PUT from your site origin with the content-type header.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Development without R2: files go to this folder (never used on Vercel). Defaults to apps/web/.uploads.
UPLOADS_DIR=
# Signs local upload/playback links. Defaults to BETTER_AUTH_SECRET. At least 32 characters.
UPLOAD_SIGNING_SECRET=
