# Apple Music (MusicKit) — developer.apple.com > Certificates, IDs & Profiles > Keys (enable MusicKit)
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
# Contents of the .p8 file. Newlines may be written as \n on one line.
APPLE_MUSIC_PRIVATE_KEY=

# YouTube Data API v3 key — console.cloud.google.com, restrict it to the YouTube Data API
YOUTUBE_API_KEY=

# Default catalog storefront (ISO country code)
DEFAULT_STOREFRONT=us

# ── Database and auth ─────────────────────────────────────────────────────
# Postgres (Neon in production). Apply migrations: pnpm --filter @vybz/db migrate
DATABASE_URL=postgres://postgres@localhost:5432/vybz
# 32+ random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of this deployment
BETTER_AUTH_URL=http://localhost:3000
# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Email (verification, password reset). Without a key, emails are printed to the console.
RESEND_API_KEY=
MAIL_FROM=VYBZ <noreply@mail.urexp.com>
# Defaults to true in production, false in development
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# ── AI judge ──────────────────────────────────────────────────────────────
# Enables the AI judging modes (AI only, crowd + AI together, separate cards).
# Without a key, those modes are offered only alongside the demo catalog, with a coin-flip stand-in.
ANTHROPIC_API_KEY=
AI_JUDGE_MODEL=claude-sonnet-5-5

# ── Development helpers ───────────────────────────────────────────────────
# Built-in catalog of synthesized tracks so battles work without provider keys. Refused on the live site.
VYBZ_DEMO_CATALOG=true
# Extra origins allowed to call the API with cookies (e.g. the Expo web build)
CORS_ORIGINS=http://localhost:8081

# ── Notifications and chat ────────────────────────────────────────────────
# Phone push via the Expo push service. Set to false to keep notifications in-app only.
PUSH_NOTIFICATIONS=true
# Only needed if "enhanced push security" is on in your Expo account
EXPO_ACCESS_TOKEN=
# Extra words to reject in battle chat, comma-separated
CHAT_BLOCKLIST=

# ── Scheduler ─────────────────────────────────────────────────────────────
# Vercel Cron calls /api/cron/advance every minute with this as a Bearer token (16+ chars)
CRON_SECRET=
